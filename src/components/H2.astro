---
interface Props {
  text: string;
  id: string;
  count?: number;
}

const { text, id, count } = Astro.props;
---

<h2
  id={id}
  class="mb-2 text-sm border-b pb-1 flex justify-between items-center"
>
  <span>{text}</span>
  {count !== undefined && <span class="text-gray-500">({count})</span>}
</h2>
