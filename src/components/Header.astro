---
const { locale } = Astro.props;
import { t } from "../i18n/helper";
---

<header
  id="header"
  class="sticky top-0 w-full z-50 flex justify-center bg-background pt-2"
>
  <nav
    id="nav"
    class="px-4 flex text-title font-medium gap-4 text-sm w-full max-w-[40rem]"
  >
    <a class="hover:underline py-2" href="/#">{t(locale, "nav_home")}</a>

    <a
      class="hover:underline py-2 text-sm ml-auto"
      href={locale === "en" ? "/es" : "/"}
    >
      {locale === "en" ? "ES" : "EN"}
    </a>
    <a class="hover:underline py-2" href="/studies">
      {t(locale, "studies")}
    </a>
    <a class="hover:underline py-2" href="/writing">
      {t(locale, "writing")}
    </a>
  </nav>
</header>
