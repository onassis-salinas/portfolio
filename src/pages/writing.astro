---
import Layout from "@/layouts/Layout.astro";

const matches = import.meta.glob("./writing/*.md", { eager: true });
let posts = Object.values(matches);

posts = posts
    .filter((post: any) => post.frontmatter.posted)
    .sort((a: any, b: any) => {
        return (
            new Date(b.frontmatter.date).getTime() -
            new Date(a.frontmatter.date).getTime()
        );
    });
---

<Layout title="Writing" locale="en">
    <div class="mt-20">
        <h1>Writing</h1>
        <p>
            Notes and thoughts on the process of building some of my projects.
        </p>

        <div class="space-y-4 mt-10">
            {
                posts.map((post: any) => (
                    <a
                        href={post.url}
                        class="w-full flex flex-col border-b pb-4"
                    >
                        <h3 class="text-title font-medium leading-none">
                            {post.frontmatter.title}
                        </h3>
                        <p class="text-sm mt-1">
                            {new Date(post.frontmatter.date).toLocaleDateString(
                                "en-US",
                                {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric",
                                },
                            )}
                        </p>
                    </a>
                ))
            }
        </div>
    </div>
</Layout>
