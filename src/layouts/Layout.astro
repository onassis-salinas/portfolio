---
import type { Locale } from "../i18n/helper";

interface Props {
  title: string;
  locale: Locale;
  main?: boolean;
}

const { title, locale, main } = Astro.props;

import Header from "@/components/Header.astro";
import "@/styles/global.css";

const baseUrl = "https://onassis.dev";
const canonicalPath = locale === "en" ? "/" : `/${locale}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    {main && (
      <link rel="canonical" href={`${baseUrl}${canonicalPath}`} />
      <link rel="alternate" hreflang="en" href={`${baseUrl}/`} />
      <link rel="alternate" hreflang="es" href={`${baseUrl}/es`} />
      <link rel="alternate" hreflang="x-default" href={`${baseUrl}/`} />
    )}
  </head>
  <body class="relative min-h-screen flex flex-col pb-24">
    <Header locale={locale} />
    <main class="max-w-[40rem] mx-auto z-10 space-y-20 px-4 flex-1 w-full">
      <slot />
    </main>
  </body>
</html>
